    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@autovul/codeql-runner": "0.1.0",
    "@autovul/contracts": "0.1.0",
    "@autovul/core": "0.1.0"
  }
